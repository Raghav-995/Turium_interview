# AI Knowledge Inbox Configuration

# LLM Provider: 'gemini', 'openai', or 'mock'
LLM_PROVIDER=gemini

# Google AI Studio Gemini API Key (Get free key at: https://aistudio.google.com/app/apikey)
GEMINI_API_KEY=

# Optional: OpenAI API Key (if using OpenAI instead)
OPENAI_API_KEY=

# Models
GEMINI_MODEL=gemini-2.5-flash
GEMINI_EMBEDDING_MODEL=text-embedding-004

OPENAI_MODEL=gpt-4o-mini
OPENAI_EMBEDDING_MODEL=text-embedding-3-small

# RAG & Chunking Settings
CHUNK_SIZE=500
CHUNK_OVERLAP=100
TOP_K_CHUNKS=4
SIMILARITY_THRESHOLD=0.20
